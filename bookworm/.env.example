PORT=3080
SECRET_KEY=change-me-in-production
DATA_PATH=./data
BACKUP_PATH=./backups
DOWNLOADS_PATH=./downloads

# User/group IDs for linuxserver containers (run: id $USER on your NAS)
PUID=1000
PGID=1000
TZ=Europe/London

# Prowlarr (indexer aggregator — set up separately)
PROWLARR_URL=http://your-nas:9696
PROWLARR_API_KEY=your-key-here

# Readarr (book manager — included in this compose)
READARR_PORT=8787

# qBittorrent (external, already running)
QBIT_URL=http://your-nas:8090
QBIT_USER=admin
QBIT_PASS=your-password
